// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * Redmi AX3000 (RA81) - IPQ5018 + QCA8337 + QCN6102
 *
 * Ported from hzyitc/openwrt-redmi-ax3000 to the mainline qualcommax layout:
 *   - ethernet: stmmac (gmac0/gmac1) + DSA qca8337, instead of qca-nss-dp
 *   - wifi:     ath11k ahb multipd (wifi + wifi1), instead of QSDK nss-dp tree
 *
 * Hardware:
 *   SoC      IPQ5018 (IPQ5000), dual core A53
 *   2.4G     IPQ5018 built-in (AHB), 2x2
 *   5G       QCN6102, runs as a WCSS userpd (multipd), 2x2 160MHz
 *   switch   QCA8337: port1-3 = LAN1-3, port4 = WAN,
 *                     port5 = IPQ5018 GE PHY, port6 = SGMII CPU port
 *   NAND     128 MiB, dual rootfs (A/B) layout inherited from stock
 */

/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Redmi AX3000";
	compatible = "redmi,ax3000", "qcom,ipq5018";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		label-mac-device = &gmac0;
		led-boot = &led_system_blue;
		led-failsafe = &led_system_yellow;
		led-running = &led_system_blue;
		led-upgrade = &led_system_yellow;
		serial0 = &blsp1_uart1;
	};

	chosen {
		/*
		 * Do NOT pin ubi.mtd here. The stock bootloader passes
		 * "ubi.mtd=rootfs" or "ubi.mtd=rootfs_1" depending on the boot
		 * slot flag, and that is the only thing that makes the A/B
		 * layout work: the installer flashes the *other* slot, then
		 * flips the flag. Appending our own ubi.mtd= would attach the
		 * wrong (or both) UBI devices and boot the old system.
		 *
		 * root=/dev/ubiblock0_1 is slot-independent: it refers to UBI
		 * device 0, volume 1 (KERNEL_IN_UBI), whichever mtd it came from.
		 */
		bootargs-append = " root=/dev/ubiblock0_1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		reset-button {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		wps-button {
			label = "wps";
			gpios = <&tlmm 23 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_blue: system-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_system_yellow: system-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
		};

		led_net_blue: net-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		};

		led_net_yellow: net-yellow {
			color = <LED_COLOR_ID_YELLOW>;
			function = LED_FUNCTION_WAN;
			gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* ath11k + QCN6102 userpd needs a fixed pool, see stock layout */
		q6_mem_regions: q6_mem_regions@4b000000 {
			no-map;
			reg = <0x0 0x4b000000 0x0 0x3000000>;
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-step-size = <512>;
		nand-ecc-strength = <8>;
		nand-bus-width = <8>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:sbl1";
				reg = <0x00000000 0x00080000>;
				read-only;
			};

			partition@80000 {
				label = "0:mibib";
				reg = <0x00080000 0x00080000>;
				read-only;
			};

			partition@100000 {
				label = "0:bootconfig";
				reg = <0x00100000 0x00040000>;
				read-only;
			};

			partition@140000 {
				label = "0:bootconfig1";
				reg = <0x00140000 0x00040000>;
				read-only;
			};

			partition@180000 {
				label = "0:qsee";
				reg = <0x00180000 0x00100000>;
				read-only;
			};

			partition@280000 {
				label = "0:qsee_1";
				reg = <0x00280000 0x00100000>;
				read-only;
			};

			partition@380000 {
				label = "0:devcfg";
				reg = <0x00380000 0x00040000>;
				read-only;
			};

			partition@3c0000 {
				label = "0:devcfg_1";
				reg = <0x003c0000 0x00040000>;
				read-only;
			};

			partition@400000 {
				label = "0:cdt";
				reg = <0x00400000 0x00040000>;
				read-only;
			};

			partition@440000 {
				label = "0:cdt_1";
				reg = <0x00440000 0x00040000>;
				read-only;
			};

			partition@480000 {
				label = "0:appsblenv";
				reg = <0x00480000 0x00080000>;
			};

			partition@500000 {
				label = "0:appsbl";
				reg = <0x00500000 0x00140000>;
				read-only;
			};

			partition@640000 {
				label = "0:appsbl_1";
				reg = <0x00640000 0x00140000>;
				read-only;
			};

			partition@780000 {
				label = "0:art";
				reg = <0x00780000 0x00100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					mac_addr_gmac1: macaddr@0 {
						reg = <0x0 0x6>;
					};

					mac_addr_gmac0: macaddr@6 {
						reg = <0x6 0x6>;
					};
				};
			};

			partition@880000 {
				label = "0:training";
				reg = <0x00880000 0x00080000>;
				read-only;
			};

			partition@900000 {
				label = "bdata";
				reg = <0x00900000 0x00080000>;
			};

			partition@980000 {
				label = "crash";
				reg = <0x00980000 0x00080000>;
			};

			partition@a00000 {
				label = "crash_syslog";
				reg = <0x00a00000 0x00080000>;
			};

			/*
			 * Slot A. Matches stock "rootfs" (mtd18), 36 MiB.
			 * UBI volume 0 = kernel, volume 1 = rootfs.
			 */
			partition@a80000 {
				label = "rootfs";
				reg = <0x00a80000 0x02400000>;
			};

			/*
			 * Slot B. Must stay writable: installing from the stock
			 * firmware means the vendor system is running from slot A,
			 * so the only safe target is this one (ubiformat rootfs_1).
			 * Marking it read-only makes ubiformat fail with EROFS.
			 */
			partition@2e80000 {
				label = "rootfs_1";
				reg = <0x02e80000 0x02400000>;
			};

			partition@5280000 {
				label = "overlay";
				reg = <0x05280000 0x01f00000>;
			};

			partition@7180000 {
				label = "rsvd0";
				reg = <0x07180000 0x00080000>;
				read-only;
			};
		};
	};
};

/*
 * =================================================================
 *     _______________________             _______________________
 *    |        IPQ5018        |           |        QCA8337        |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | | MAC0 |---| GE Phy |-+--- MDI ---+ | Phy4   |---| MAC5 | |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | | MAC1 |---| Uniphy |-+-- SGMII---+ | SerDes |---| MAC6 | |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    |_______________________|           |_______________________|
 *
 * =================================================================
 */

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

// MAC0 -> GE Phy -> QCA8337 Phy4
&gmac0 {
	status = "okay";

	nvmem-cells = <&mac_addr_gmac0 0>;
	nvmem-cell-names = "mac-address";
};

// MAC1 ---SGMII---> QCA8337 MAC6 (CPU port)
&gmac1 {
	status = "okay";

	phy-mode = "sgmii";

	nvmem-cells = <&mac_addr_gmac1 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;

	// QCA8337 Phy0 -> LAN1
	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	// QCA8337 Phy1 -> LAN2
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	// QCA8337 Phy2 -> LAN3
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	// QCA8337 Phy3 -> WAN
	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	// QCA8337 Phy4 -> IPQ5018 GE Phy
	qca8337_4: ethernet-phy@4 {
		reg = <4>;
	};

	ethernet-switch@11 {
		compatible = "qca,qca8337";
		reg = <0x11>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&qca8337_0>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&qca8337_2>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "wan";
				phy-handle = <&qca8337_3>;

				nvmem-cells = <&mac_addr_gmac0 0>;
				nvmem-cell-names = "mac-address";
			};

			ethernet-port@5 {
				reg = <5>;
				phy-handle = <&qca8337_4>;
				phy-mode = "gmii";
				ethernet = <&gmac0>;
			};

			ethernet-port@6 {
				reg = <6>;
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		pins = "gpio23", "gpio25";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	leds_pins: leds-state {
		pins = "gpio17", "gpio19", "gpio20", "gpio22";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
};

&q6v5_wcss {
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt",
			"ath11k/QCN6122/hw1.0/m3_fw.mdt";
};

/*
 * 2.4GHz: IPQ5018 built-in radio, runs on WCSS pd-1.
 *
 * board_id is NOT set from DT: mainline ath11k reads it from the QMI
 * CALIB data in "0:art", which every RA81 carries pre-calibrated (M81 = 0x24).
 * The BDF shipped in ipq-wifi-redmi_ax3000 covers both 0x10 (M79/CR880x)
 * and 0x24 (M81/RA81), so a CR880x can use the same image unmodified.
 */
&wifi {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4c400000>;
};

/*
 * 5GHz: QCN6102, driven through the WCSS pd-2 userpd (multipd).
 * Same firmware family as QCN6122, hence the QCN6122 m3 image path.
 * board_id 0x60 is what the QCN6102 silicon reports.
 */
&wifi1 {
	status = "okay";

	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,board_id = <0x60>;
	qcom,ath11k-fw-memory-mode = <2>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};
